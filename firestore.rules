rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'nour2007papa@gmail.com';
    }

    // حقل نصي اختياري: غير موجود، أو null، أو string بطول أقصى محدد.
    function optStr(d, f, max) {
      return !(f in d)
        || d[f] == null
        || (d[f] is string && d[f].size() <= max);
    }

    // حقل اختياري نص قصير أو رقم صغير (عدد الركاب / الحقائب).
    function optStrOrNum(d, f, max) {
      return !(f in d)
        || d[f] == null
        || (d[f] is string && d[f].size() <= max)
        || (d[f] is number && d[f] >= 0 && d[f] <= 1000);
    }

    match /bookings/{bookingId} {
      // الزائر يستطيع إنشاء طلب جديد فقط، ولا يستطيع القراءة أو التعديل أو الحذف.
      allow create: if request.auth == null
        && request.resource.data.keys().hasOnly([
          'editToken', 'name', 'titolo', 'country', 'phone', 'service', 'serviceDate',
          'people', 'flight', 'hotel', 'bags', 'details', 'lang',
          'tipoServizio', 'lingua', 'dataOra', 'zona', 'destinazione',
          'volo', 'passeggeri', 'bagagli', 'confirmed', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'phone', 'createdAt', 'confirmed', 'editToken'
        ])
        && request.resource.data.editToken is string
        && request.resource.data.editToken.size() == 32
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.phone.size() <= 20
        // حقول نصية اختيارية — كلها بحد أقصى للطول ونوع string
        && optStr(request.resource.data, 'titolo', 20)
        && optStr(request.resource.data, 'details', 500)
        && optStr(request.resource.data, 'zona', 120)
        && optStr(request.resource.data, 'destinazione', 120)
        && optStr(request.resource.data, 'volo', 20)
        && optStr(request.resource.data, 'flight', 20)
        && optStr(request.resource.data, 'hotel', 120)
        && optStr(request.resource.data, 'country', 10)
        && optStr(request.resource.data, 'service', 60)
        && optStr(request.resource.data, 'serviceDate', 40)
        && optStr(request.resource.data, 'dataOra', 40)
        && optStrOrNum(request.resource.data, 'people', 10)
        && optStrOrNum(request.resource.data, 'passeggeri', 10)
        && optStrOrNum(request.resource.data, 'bags', 10)
        && optStrOrNum(request.resource.data, 'bagagli', 10)
        && (!('lang' in request.resource.data)
            || request.resource.data.lang == null
            || request.resource.data.lang in ['ar', 'it', 'en', 'altro'])
        && request.resource.data.lingua in ['ar', 'it', 'en', 'altro']
        && request.resource.data.tipoServizio in [
          'aeroporto', 'business', 'milano', 'evento', 'intercity', 'altro'
        ]
        && request.resource.data.createdAt == request.time
        && request.resource.data.confirmed == false;
      allow read, update, delete: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
